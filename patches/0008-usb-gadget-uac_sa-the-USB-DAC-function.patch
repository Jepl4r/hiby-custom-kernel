+	.bDescriptorType = USB_DT_CS_INTERFACE,
+
+	.bDescriptorSubtype = UAC_OUTPUT_TERMINAL,
+	.bTerminalID = USB_OUT_OT_ID,
+	.wTerminalType = cpu_to_le16(UAC_OUTPUT_TERMINAL_HEADPHONES),
+	.bAssocTerminal = 0,
+	.bSourceID = USB_OUT_FU_ID,
+	.bCSourceID = USB_OUT_CLK_ID,
+	.bmControls = 0,
+};
+
+static struct uac2_ac_header_descriptor ac_hdr_desc = {
+	.bLength = sizeof ac_hdr_desc,
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+
+	.bDescriptorSubtype = UAC_MS_HEADER,
+	.bcdADC = cpu_to_le16(0x200),
+	.bCategory = UAC2_FUNCTION_HEADSET,
+	.wTotalLength = cpu_to_le16(sizeof usb_out_clk_src_desc
+				    + sizeof usb_out_it_desc
+				    + sizeof usb_out_feature_desc
+				    + sizeof usb_out_ot_desc
+				    + sizeof ac_hdr_desc),
+	.bmControls = 0,
+};
+
+/* Alternate 0: no bandwidth */
+static struct usb_interface_descriptor usb_out_if0_desc = {
+	.bLength = sizeof usb_out_if0_desc,
+	.bDescriptorType = USB_DT_INTERFACE,
+
+	.bAlternateSetting = 0,
+	.bNumEndpoints = 0,
+	.bInterfaceClass = USB_CLASS_AUDIO,
+	.bInterfaceSubClass = USB_SUBCLASS_AUDIOSTREAMING,
+	.bInterfaceProtocol = UAC_VERSION_2,
+};
+
+#define USB_OUT_IF_DESC(_name, _alt)					\
+static struct usb_interface_descriptor _name = {			\
+	.bLength = sizeof(struct usb_interface_descriptor),		\
+	.bDescriptorType = USB_DT_INTERFACE,				\
+									\
+	.bAlternateSetting = _alt,					\
+	.bNumEndpoints = 2,						\
+	.bInterfaceClass = USB_CLASS_AUDIO,				\
+	.bInterfaceSubClass = USB_SUBCLASS_AUDIOSTREAMING,		\
+	.bInterfaceProtocol = UAC_VERSION_2,				\
+}
+
+#define USB_OUT_HDR_DESC(_name, _formats, _chcfg)			\
+static struct uac2_as_header_descriptor _name = {			\
+	.bLength = sizeof(struct uac2_as_header_descriptor),		\
+	.bDescriptorType = USB_DT_CS_INTERFACE,				\
+									\
+	.bDescriptorSubtype = UAC_AS_GENERAL,				\
+	.bTerminalLink = USB_OUT_IT_ID,					\
+	.bmControls = 0,						\
+	.bFormatType = UAC_FORMAT_TYPE_I,				\
+	.bmFormats = cpu_to_le32(_formats),				\
+	.bNrChannels = 2,						\
+	.bmChannelConfig = cpu_to_le32(_chcfg),			\
+	.iChannelNames = 0,						\
+}
+
+#define USB_OUT_FMT_DESC(_name, _subslot, _bits)			\
+static struct uac2_format_type_i_descriptor _name = {			\
+	.bLength = sizeof(struct uac2_format_type_i_descriptor),	\
+	.bDescriptorType = USB_DT_CS_INTERFACE,				\
+	.bDescriptorSubtype = UAC_FORMAT_TYPE,				\
+	.bFormatType = UAC_FORMAT_TYPE_I,				\

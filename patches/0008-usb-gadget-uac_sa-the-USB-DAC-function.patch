+/*
+ * f_uac_sa.c -- USB Audio Class 2.0 "USB DAC" function
+ *
+ * The function the vendor firmware calls uac_sa: the player shows up on the
+ * host as an asynchronous UAC2 speaker and hands what the host plays to user
+ * space through /dev/uac_sa, which the player reads and sends to its own DAC.
+ *
+ * Host-to-device only: one streaming interface with four formats (24-bit,
+ * 16-bit, 32-bit PCM and, when dsd_native_enable is on, 32-bit raw data for
+ * native DSD), rates from 32 to 384 kHz, and an explicit feedback endpoint
+ * that tracks how full the buffer in between is, so the host follows the
+ * player's clock. Every PCM format reaches user space as 32-bit stereo.
+ *
+ * Descriptors, ioctls and sysfs attributes are the vendor kernel's, so its
+ * user space and ours both work unchanged:
+ *
+ *   configfs  functions/uac_sa.<name>/{c,p}_{chmask,srate,ssize} (accepted,
+ *             not used: the formats are fixed)
+ *   /dev/uac_sa
+ *     read()   whole buffers only: 0 while less than asked for is queued,
+ *              -1 when the format changed since the last UAC_IOCTL_FORMAT,
+ *              or for more than half the buffer
+ *     ioctl 0  int: 1 once the buffer is half full, 0 before
+ *     ioctl 1  struct { int format; int rate; int bits; }: format 2 for
+ *              native DSD, 1 for PCM; bits always 32
+ *   /sys/class/uac_sa/uac_sa/{dynamic_feedback,dsd_native_enable,
+ *                             string_assoc}
+ *
+ * Built on f_uac2.c:
+ * Copyright (C) 2011
+ *    Yadwinder Singh (yadi.brar01@gmail.com)
+ *    Jaswinder Singh (jaswinder.singh@linaro.org)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <linux/cdev.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+#include <linux/usb/audio.h>
+#include <linux/usb/audio-v2.h>
+#include <linux/usb/composite.h>
+#include <linux/vmalloc.h>
+#include <asm/unaligned.h>
+
+#include "u_uac2.h"
+
+#define UAC_SA_NAME		"uac_sa"
+
+/* Entity IDs */
+#define USB_OUT_CLK_ID		1
+#define USB_OUT_IT_ID		2
+#define USB_OUT_FU_ID		3
+#define USB_OUT_OT_ID		4
+
+/* Alternate settings of the streaming interface */
+#define ALT_PCM24		1
+#define ALT_PCM16		2
+#define ALT_PCM32		3
+#define ALT_NATIVE		4
+
+/* What UAC_IOCTL_FORMAT reports */
+#define UAC_FORMAT_PCM		1
+#define UAC_FORMAT_NATIVE	2
+
+#define UAC_IOCTL_STATE		0
+#define UAC_IOCTL_FORMAT	1
+
+#define DEFAULT_RATE		44100
+#define FEEDBACK_STEPS		33
+
+/* The largest buffer, the one for 352.8 and 384 kHz. */
+#define RING_MAX		(512 * 1024)
+
+/* Sample size each alternate setting carries, in bits. */
+static const u8 usb_out_alt_bits[] = {
+	[0]		= 0,
+	[ALT_PCM24]	= 24,
+	[ALT_PCM16]	= 16,
+	[ALT_PCM32]	= 32,
+	[ALT_NATIVE]	= 32,
+};
+
+static int dynamic_feedback = 1;
+static int dsd_native_enable = 1;
+static char string_assoc[16] = "usb dac";
+
+/*
+ * Bytes queued between the host and the reader. One producer, the OUT
+ * endpoint's completion; one consumer, read(). The lock covers the offsets
+ * only: read() copies to user space outside it, from bytes the producer does
+ * not touch until tail moves past them.
+ */
+struct uac_ring {
+	spinlock_t lock;
+	u8 *buf;		/* RING_MAX bytes */
+	unsigned int size;	/* in use for the current rate */
+	unsigned int head;	/* next byte written */
+	unsigned int tail;	/* next byte read */
+	unsigned int gen;	/* bumped by every reset */
+};
+
+struct uac_ep {
+	struct usb_ep *ep;
+	struct usb_request *req;
+	void *buf;
+	unsigned int max_psize;
+	bool enabled;
+};
+
+struct audio_dev {
+	u8 ac_intf, ac_alt;
+	u8 as_out_intf, as_out_alt;
+	u8 last_alt;
+
+	struct usb_function func;
+
+	struct uac_ep out;		/* the samples */
+	struct uac_ep fb;		/* the feedback */
+
+	struct cdev cdev;
+	dev_t devt;
+	struct class *class;
+	struct device *device;
+
+	struct uac_ring ring;
+	unsigned int rate;
+	unsigned int bits;
+	bool format_changed;
+
+	struct usb_ctrlrequest setup_ctrl;
+};
+
+/*
+ * The function exists once. user space reaches it through the char device,
+ * which can outlive it; uac_sa_lock keeps g_agdev and its buffers valid for
+ * as long as a read or an ioctl uses them.
+ */
+static struct audio_dev *g_agdev;
+static DEFINE_MUTEX(uac_sa_lock);
+static atomic_t uac_open_count = ATOMIC_INIT(0);
+
+static inline struct audio_dev *func_to_agdev(struct usb_function *f)
+{
+	return container_of(f, struct audio_dev, func);
+}
+
+/* --------------------------------------------------------------------------
+ * Descriptors: high speed only, byte for byte the vendor's.
+ */

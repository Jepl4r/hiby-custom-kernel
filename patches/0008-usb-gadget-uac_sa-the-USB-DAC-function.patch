+
+static int rate_index(unsigned int rate)
+{
+	switch (rate) {
+	case 32000:	return 0;
+	case 44100:	return 1;
+	case 48000:	return 2;
+	case 88200:	return 3;
+	case 96000:	return 4;
+	case 176400:	return 5;
+	case 192000:	return 6;
+	case 352800:	return 7;
+	case 384000:	return 8;
+	default:	return 1;
+	}
+}
+
+/* Buffer size for a rate: about 370 ms of 32-bit stereo. */
+static unsigned int ring_size_for(unsigned int rate)
+{
+	if (rate > 192000)
+		return 512 * 1024;
+	if (rate > 96000)
+		return 256 * 1024;
+	if (rate > 48000)
+		return 128 * 1024;
+	return 64 * 1024;
+}
+
+static unsigned int ring_fill(const struct uac_ring *r)
+{
+	return (r->head - r->tail + r->size) % r->size;
+}
+
+/* Called with ring->lock held. */
+static u32 calc_feed_back(const struct uac_ring *r, unsigned int rate)
+{
+	int idx = FEEDBACK_STEPS / 2;
+
+	if (dynamic_feedback && r->size >= 32) {
+		int free = r->size - 1 - ring_fill(r);
+
+		idx += (free - (int)r->size / 2) / ((int)r->size / 32);
+		idx = clamp(idx, 0, FEEDBACK_STEPS - 1);
+	}
+
+	return fb_val[rate_index(rate)][idx] << 1;
+}
+
+/* Called with ring->lock held. */
+static void ring_reset(struct uac_ring *r, unsigned int rate)
+{
+	r->size = ring_size_for(rate);
+	r->head = 0;
+	r->tail = 0;
+	r->gen++;
+}
+
+/* --------------------------------------------------------------------------
+ * Streaming
+ */
+
+/* PCM samples go to user space as 32-bit, left aligned; len is in output bytes. */
+static void audio_copy_16to32(u8 *dst, const u8 *src, unsigned int len)
+{
+	u32 *d = (u32 *)dst;
+	const u16 *s = (const u16 *)src;
+
+	for (; len >= 8; len -= 8) {
+		*d++ = (u32)get_unaligned_le16(s++) << 16;
+		*d++ = (u32)get_unaligned_le16(s++) << 16;
+	}
+}
+
+static void audio_copy_24to32(u8 *dst, const u8 *src, unsigned int len)
+{
+	u32 *d = (u32 *)dst;
+
+	for (; len >= 8; len -= 8, src += 6) {
+		*d++ = (u32)src[0] << 8 | (u32)src[1] << 16 | (u32)src[2] << 24;
+		*d++ = (u32)src[3] << 8 | (u32)src[4] << 16 | (u32)src[5] << 24;
+	}
+}
+
+static void audio_copy_32to32(u8 *dst, const u8 *src, unsigned int len)
+{
+	memcpy(dst, src, len);
+}
+
+/* Stores one OUT packet; a packet the buffer has no room for is dropped. */
+static void ring_store(struct audio_dev *agdev, const u8 *src, unsigned int n)
+{
+	struct uac_ring *r = &agdev->ring;
+	void (*copy)(u8 *, const u8 *, unsigned int);
+	unsigned int in_frame, out_len, free, first;
+
+	switch (agdev->bits) {
+	case 16:
+		in_frame = 4;
+		copy = audio_copy_16to32;
+		break;
+	case 24:
+		in_frame = 6;
+		copy = audio_copy_24to32;
+		break;
+	default:
+		in_frame = 8;
+		copy = audio_copy_32to32;
+		break;
+	}
+
+	n -= n % in_frame;
+	out_len = n / in_frame * 8;
+	if (!out_len)
+		return;
+
+	spin_lock(&r->lock);
+	if (!r->buf || !r->size)
+		goto out;
+
+	/* Eight bytes always stay free so head never catches up with tail. */
+	free = r->size - 1 - ring_fill(r);
+	free = free >= 8 ? (free - 8) & ~7u : 0;
+	if (free < out_len)
+		goto out;
+
+	first = min(out_len, r->size - r->head);
+	copy(r->buf + r->head, src, first);
+	if (first < out_len)
+		copy(r->buf, src + first / 8 * in_frame, out_len - first);
+	r->head = (r->head + out_len) % r->size;
+out:
+	spin_unlock(&r->lock);
+}
+
+/*
+ * The function is found through req->context: configfs clears every
+ * ep->driver_data with usb_ep_autoconfig_reset() once the functions are bound.
+ */
+static void agdev_iso_out_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct audio_dev *agdev = req->context;
+	int err;
+
+	if (!agdev || !agdev->out.enabled)
+		return;
+
+	if (req->status == -ESHUTDOWN || req->status == -ECONNRESET)
+		return;
+	if (req->status == 0 && req->actual)
+		ring_store(agdev, req->buf, req->actual);
+
+	err = usb_ep_queue(ep, req, GFP_ATOMIC);
+	if (err)
+		dev_err(&agdev->func.config->cdev->gadget->dev,
+			"%s: cannot queue the OUT request: %d\n", __func__, err);
+}
+
+static void agdev_feedback_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct audio_dev *agdev = req->context;
+	unsigned long flags;
+	u32 fb;
+	int err;
+
+	if (!agdev || !agdev->fb.enabled)
+		return;
+	/* A missed interval is not the end of the stream; an unlink is. */
+	if (req->status == -ESHUTDOWN || req->status == -ECONNRESET)
+		return;
+
+	spin_lock_irqsave(&agdev->ring.lock, flags);
+	fb = calc_feed_back(&agdev->ring, agdev->rate);
+	spin_unlock_irqrestore(&agdev->ring.lock, flags);
+
+	put_unaligned_le32(fb, req->buf);
+	req->length = 4;
+
+	err = usb_ep_queue(ep, req, GFP_ATOMIC);
+	if (err)
+		dev_err(&agdev->func.config->cdev->gadget->dev,
+			"%s: cannot queue the feedback request: %d\n",
+			__func__, err);
+}
+
+static void uac_ep_stop(struct uac_ep *uep)
+{
+	uep->enabled = false;
+	if (uep->req) {
+		usb_ep_dequeue(uep->ep, uep->req);
+		usb_ep_free_request(uep->ep, uep->req);
+		uep->req = NULL;
+	}
+	usb_ep_disable(uep->ep);
+}
+
+static int uac_ep_start(struct audio_dev *agdev, struct uac_ep *uep,
+			void (*complete)(struct usb_ep *, struct usb_request *))
+{
+	struct usb_gadget *gadget = agdev->func.config->cdev->gadget;
+	struct usb_request *req;
+	int err;
+
+	err = config_ep_by_speed(gadget, &agdev->func, uep->ep);
+	if (err)
+		return err;
+
+	uep->enabled = true;
+	usb_ep_enable(uep->ep);
+
+	req = usb_ep_alloc_request(uep->ep, GFP_ATOMIC);
+	if (!req)
+		return -ENOMEM;
+
+	uep->req = req;
+	req->zero = 0;
+	req->context = agdev;
+	req->length = uep->max_psize;
+	req->complete = complete;
+	req->buf = uep->buf;
+
+	if (complete == agdev_feedback_complete) {
+		unsigned long flags;
+		u32 fb;
+
+		spin_lock_irqsave(&agdev->ring.lock, flags);
+		fb = calc_feed_back(&agdev->ring, agdev->rate);
+		spin_unlock_irqrestore(&agdev->ring.lock, flags);
+		put_unaligned_le32(fb, req->buf);
+		req->length = 4;
+	}
+
+	err = usb_ep_queue(uep->ep, req, GFP_ATOMIC);
+	if (err)
+		dev_err(&gadget->dev, "%s: cannot queue on %s: %d\n",
+			__func__, uep->ep->name, err);
+	return 0;
+}
+
+/* --------------------------------------------------------------------------
+ * /dev/uac_sa
+ */
+
+static int uac_open(struct inode *inode, struct file *file)
+{
+	if (atomic_cmpxchg(&uac_open_count, 0, 1))
+		return -EBUSY;
+	return 0;
+}
+
+static int uac_close(struct inode *inode, struct file *file)
+{
+	atomic_set(&uac_open_count, 0);
+	return 0;
+}
+
+/* Whole requests only, so a frame is never split between two reads. */
+static ssize_t uac_read(struct file *file, char __user *buf, size_t count,
+			loff_t *ppos)
+{
+	struct audio_dev *agdev;
+	struct uac_ring *r;
+	unsigned int tail, size, gen, first;
+	unsigned long flags;
+	ssize_t ret = -EPERM;
+
+	mutex_lock(&uac_sa_lock);
+	agdev = g_agdev;
+	if (!agdev || !agdev->ring.buf)
+		goto out;
+	r = &agdev->ring;
+
+	if (agdev->format_changed) {
+		agdev->format_changed = false;
+		goto out;
+	}
+
+	spin_lock_irqsave(&r->lock, flags);
+	size = r->size;
+	tail = r->tail;
+	gen = r->gen;
+	if (count > size / 2) {
+		spin_unlock_irqrestore(&r->lock, flags);
+		goto out;
+	}
+	if (ring_fill(r) < count) {
+		spin_unlock_irqrestore(&r->lock, flags);
+		ret = 0;
+		goto out;
+	}
+	spin_unlock_irqrestore(&r->lock, flags);
+
+	first = min_t(size_t, count, size - tail);
+	if (copy_to_user(buf, r->buf + tail, first) ||
+	    copy_to_user(buf + first, r->buf, count - first)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	spin_lock_irqsave(&r->lock, flags);
+	if (r->gen == gen)
+		r->tail = (tail + count) % size;
+	spin_unlock_irqrestore(&r->lock, flags);
+	ret = count;
+out:
+	mutex_unlock(&uac_sa_lock);
+	return ret;
+}
+
+static long uac_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct audio_dev *agdev;
+	long ret = 0;
+
+	mutex_lock(&uac_sa_lock);
+	agdev = g_agdev;
+	if (!agdev) {
+		ret = -EPERM;
+		goto out;
+	}
+
+	switch (cmd) {
+	case UAC_IOCTL_STATE: {
+		unsigned long flags;
+		int state = 0;
+
+		spin_lock_irqsave(&agdev->ring.lock, flags);
+		if (agdev->ring.buf && agdev->ring.size &&
+		    ring_fill(&agdev->ring) >= agdev->ring.size / 2)
+			state = 1;
+		spin_unlock_irqrestore(&agdev->ring.lock, flags);
+		if (copy_to_user((void __user *)arg, &state, sizeof(state)))
+			ret = -EFAULT;
+		break;
+	}
+	case UAC_IOCTL_FORMAT: {
+		int fmt[3];
+
+		fmt[0] = agdev->as_out_alt == ALT_NATIVE ?
+			 UAC_FORMAT_NATIVE : UAC_FORMAT_PCM;
+		fmt[1] = agdev->rate;
+		fmt[2] = 32;
+		if (copy_to_user((void __user *)arg, fmt, sizeof(fmt)))
+			ret = -EFAULT;
+		agdev->format_changed = false;
+		break;
+	}
+	default:
+		break;
+	}
+out:
+	mutex_unlock(&uac_sa_lock);
+	return ret;
+}
+
+static const struct file_operations f_ops = {
+	.owner = THIS_MODULE,
+	.read = uac_read,
+	.unlocked_ioctl = uac_ioctl,
+	.open = uac_open,
+	.release = uac_close,
+};
+
+/* --------------------------------------------------------------------------
+ * /sys/class/uac_sa/uac_sa
+ */
+
+static ssize_t dynamic_feedback_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%d\n", dynamic_feedback);
+}
+
+static ssize_t dynamic_feedback_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	int val;
+	int ret = kstrtoint(buf, 10, &val);
+
+	if (ret)
+		return ret;
+	dynamic_feedback = !!val;
+	return count;
+}
+
+/* Read when the function binds: the native format is offered or not then. */
+static ssize_t dsd_native_enable_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%s\n", dsd_native_enable ? "on" : "off");
+}
+
+static ssize_t dsd_native_enable_store(struct device *dev,
+				       struct device_attribute *attr,
+				       const char *buf, size_t count)
+{
+	dsd_native_enable = !strncmp(buf, "on", 2);
+	return count;
+}
+
+static ssize_t string_assoc_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%s\n", string_assoc);
+}
+
+static ssize_t string_assoc_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	if (count > sizeof(string_assoc))
+		return -EINVAL;
+	strlcpy(string_assoc, buf, sizeof(string_assoc));
+	strim(string_assoc);
+	return count;
+}
+
+static DEVICE_ATTR_RW(dynamic_feedback);
+static DEVICE_ATTR_RW(dsd_native_enable);
+static DEVICE_ATTR_RW(string_assoc);
+
+static struct attribute *uac_sa_attrs[] = {
+	&dev_attr_dynamic_feedback.attr,
+	&dev_attr_dsd_native_enable.attr,
+	&dev_attr_string_assoc.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(uac_sa);
+
+/* --------------------------------------------------------------------------
+ * The function
+ */
+
+static int afunc_bind(struct usb_configuration *cfg, struct usb_function *fn)
+{
+	struct audio_dev *agdev = func_to_agdev(fn);
+	struct usb_composite_dev *cdev = cfg->cdev;
+	struct usb_gadget *gadget = cdev->gadget;
+	int ret;
+
+	ret = usb_interface_id(cfg, fn);
+	if (ret < 0)
+		return ret;
+	std_ac_if_desc.bInterfaceNumber = ret;
+	iad_desc.bFirstInterface = ret;
+	agdev->ac_intf = ret;
+	agdev->ac_alt = 0;
+
+	ret = usb_interface_id(cfg, fn);
+	if (ret < 0)
+		return ret;
+	usb_out_if0_desc.bInterfaceNumber = ret;
+	usb_out_pcm16_if_desc.bInterfaceNumber = ret;
+	usb_out_pcm24_if_desc.bInterfaceNumber = ret;
+	usb_out_pcm32_if_desc.bInterfaceNumber = ret;
+	usb_out_native_if_desc.bInterfaceNumber = ret;
+	agdev->as_out_intf = ret;
+	agdev->as_out_alt = 0;
+	agdev->last_alt = 0;
+
+	ret = -ENODEV;
+	agdev->out.ep = usb_ep_autoconfig(gadget, &usb_out_hs_epout_desc);
+	if (!agdev->out.ep)
+		goto err;
+
+	agdev->fb.ep = usb_ep_autoconfig(gadget, &usb_out_hs_epin_desc);
+	if (!agdev->fb.ep)
+		goto err;
+
+	ret = usb_assign_descriptors(fn, NULL, dsd_native_enable ?
+				     hs_audio_native_desc : hs_audio_desc,
+				     NULL);
+	if (ret)
+		goto err;
+
+	ret = -ENOMEM;
+	agdev->out.max_psize = le16_to_cpu(usb_out_hs_epout_desc.wMaxPacketSize);
+	agdev->out.buf = kzalloc(agdev->out.max_psize, GFP_KERNEL);
+	if (!agdev->out.buf)
+		goto err_descs;
+
+	agdev->fb.max_psize = le16_to_cpu(usb_out_hs_epin_desc.wMaxPacketSize);
+	agdev->fb.buf = kzalloc(agdev->fb.max_psize, GFP_KERNEL);
+	if (!agdev->fb.buf)
+		goto err_descs;
+
+	agdev->ring.buf = vmalloc(RING_MAX);
+	if (!agdev->ring.buf)
+		goto err_descs;
+	agdev->rate = DEFAULT_RATE;
+	agdev->bits = 16;
+	ring_reset(&agdev->ring, agdev->rate);
+
+	ret = alloc_chrdev_region(&agdev->devt, 0, 1, UAC_SA_NAME);
+	if (ret < 0)
+		goto err_descs;
+
+	cdev_init(&agdev->cdev, &f_ops);
+	ret = cdev_add(&agdev->cdev, agdev->devt, 1);
+	if (ret < 0)
+		goto err_region;
+
+	agdev->class = class_create(THIS_MODULE, UAC_SA_NAME);
+	if (IS_ERR(agdev->class)) {
+		ret = PTR_ERR(agdev->class);
+		agdev->class = NULL;
+		goto err_cdev;
+	}
+
+	agdev->device = device_create_with_groups(agdev->class, NULL,
+						  agdev->devt, NULL,
+						  uac_sa_groups, UAC_SA_NAME);
+	if (IS_ERR(agdev->device)) {
+		ret = PTR_ERR(agdev->device);
+		agdev->device = NULL;
+		goto err_class;
+	}
+
+	return 0;
+
+err_class:
+	class_destroy(agdev->class);
+	agdev->class = NULL;
+err_cdev:
+	cdev_del(&agdev->cdev);
+err_region:
+	unregister_chrdev_region(agdev->devt, 1);
+err_descs:
+	usb_free_all_descriptors(fn);
+err:
+	vfree(agdev->ring.buf);
+	agdev->ring.buf = NULL;
+	kfree(agdev->out.buf);
+	agdev->out.buf = NULL;
+	kfree(agdev->fb.buf);
+	agdev->fb.buf = NULL;
+	return ret;
+}
+
+static void afunc_unbind(struct usb_configuration *c, struct usb_function *fn)
+{
+	struct audio_dev *agdev = func_to_agdev(fn);
+	u8 *ring;
+
+	mutex_lock(&uac_sa_lock);
+	if (agdev->device)
+		device_destroy(agdev->class, agdev->devt);
+	agdev->device = NULL;
+	if (agdev->class)
+		class_destroy(agdev->class);
+	agdev->class = NULL;
+	cdev_del(&agdev->cdev);
+	unregister_chrdev_region(agdev->devt, 1);
+
+	kfree(agdev->out.buf);
+	agdev->out.buf = NULL;
+	kfree(agdev->fb.buf);
+	agdev->fb.buf = NULL;
+	spin_lock_irq(&agdev->ring.lock);
+	ring = agdev->ring.buf;
+	agdev->ring.buf = NULL;
+	spin_unlock_irq(&agdev->ring.lock);
+	mutex_unlock(&uac_sa_lock);
+	vfree(ring);
+
+	usb_free_all_descriptors(fn);
+}
+
+static void afunc_stop(struct audio_dev *agdev)
+{
+	uac_ep_stop(&agdev->out);
+	uac_ep_stop(&agdev->fb);
+}
+
+static int afunc_set_alt(struct usb_function *fn, unsigned intf, unsigned alt)
+{
+	struct audio_dev *agdev = func_to_agdev(fn);
+	unsigned int alts = dsd_native_enable ? ALT_NATIVE : ALT_PCM32;
+	unsigned long flags;
+	int ret;
+
+	if (intf == agdev->ac_intf)
+		return alt ? -EINVAL : 0;
+
+	if (intf != agdev->as_out_intf || alt > alts)
+		return -EINVAL;
+
+	agdev->as_out_alt = alt;
+	if (alt == 0) {
+		afunc_stop(agdev);
+		return 0;
+	}
+
+	/* A restart in the same format is not a change for the reader. */
+	if (alt != agdev->last_alt)
+		agdev->format_changed = true;
+	agdev->last_alt = alt;
+	agdev->bits = usb_out_alt_bits[alt];
+
+	/* From one format straight to another: the old requests go first. */
+	afunc_stop(agdev);
+
+	spin_lock_irqsave(&agdev->ring.lock, flags);
+	ring_reset(&agdev->ring, agdev->rate);
+	spin_unlock_irqrestore(&agdev->ring.lock, flags);
+
+	ret = uac_ep_start(agdev, &agdev->out, agdev_iso_out_complete);
+	if (ret)
+		return ret;
+	return uac_ep_start(agdev, &agdev->fb, agdev_feedback_complete);
+}
+
+static int afunc_get_alt(struct usb_function *fn, unsigned intf)
+{
+	struct audio_dev *agdev = func_to_agdev(fn);
+
+	if (intf == agdev->ac_intf)
+		return agdev->ac_alt;
+	if (intf == agdev->as_out_intf)
+		return agdev->as_out_alt;
+	return -EINVAL;
+}
+
+static void afunc_disable(struct usb_function *fn)
+{
+	struct audio_dev *agdev = func_to_agdev(fn);
+
+	agdev->rate = DEFAULT_RATE;
+	agdev->bits = 16;
+	agdev->as_out_alt = 0;
+	afunc_stop(agdev);
+}
+
+/* SET CUR on the clock's frequency: the host picked a rate. */
+static void uac_setup_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct audio_dev *agdev = req->context;
+	struct usb_ctrlrequest *cr = &agdev->setup_ctrl;
+	unsigned long flags;
+	u32 rate;
+
+	if (req->status || req->actual < 4)
+		return;
+	if (cr->bRequest != UAC2_CS_CUR ||
+	    (le16_to_cpu(cr->wValue) >> 8) != UAC2_CS_CONTROL_SAM_FREQ ||
+	    (le16_to_cpu(cr->wIndex) >> 8) != USB_OUT_CLK_ID)
+		return;
+
+	rate = get_unaligned_le32(req->buf);
+	if (!rate || rate == agdev->rate)
+		return;
+
+	agdev->rate = rate;
+	agdev->format_changed = true;
+	spin_lock_irqsave(&agdev->ring.lock, flags);
+	ring_reset(&agdev->ring, rate);
+	spin_unlock_irqrestore(&agdev->ring.lock, flags);
+}
+
+static int afunc_setup(struct usb_function *fn, const struct usb_ctrlrequest *cr)
+{
+	struct audio_dev *agdev = func_to_agdev(fn);
+	struct usb_composite_dev *cdev = fn->config->cdev;
+	struct usb_request *req = cdev->req;
+	u16 w_length = le16_to_cpu(cr->wLength);
+	u8 control = le16_to_cpu(cr->wValue) >> 8;
+	u8 entity = le16_to_cpu(cr->wIndex) >> 8;
+	int value = -EOPNOTSUPP;
+
+	if ((cr->bRequestType & USB_TYPE_MASK) != USB_TYPE_CLASS)
+		return -EOPNOTSUPP;
+
+	if (cr->bRequestType & USB_DIR_IN) {
+		if (cr->bRequest == UAC2_CS_CUR) {
+			if (control == UAC2_CS_CONTROL_SAM_FREQ &&
+			    entity == USB_OUT_CLK_ID) {
+				put_unaligned_le32(agdev->rate, req->buf);
+				value = min_t(unsigned int, w_length, 4);
+			} else if (control == UAC2_CS_CONTROL_CLOCK_VALID) {
+				*(u8 *)req->buf = 1;
+				value = min_t(unsigned int, w_length, 1);
+			}
+		} else if (cr->bRequest == UAC2_CS_RANGE &&
+			   control == UAC2_CS_CONTROL_SAM_FREQ &&
+			   entity == USB_OUT_CLK_ID) {
+			put_unaligned_le16(ARRAY_SIZE(usb_out_rate_range),
+					   req->buf);
+			memcpy(req->buf + 2, usb_out_rate_range,
+			       sizeof usb_out_rate_range);
+			value = min_t(unsigned int, w_length,
+				      2 + sizeof usb_out_rate_range);
+		}
+	} else {
+		/* The data stage brings the value: uac_setup_complete. */
+		agdev->setup_ctrl = *cr;
+		req->context = agdev;
+		req->complete = uac_setup_complete;
+		value = w_length;
+	}
+
+	if (value < 0)
+		return value;
+
+	req->length = value;
+	req->zero = value < w_length;
+	value = usb_ep_queue(cdev->gadget->ep0, req, GFP_ATOMIC);
+	if (value < 0) {
+		dev_err(&cdev->gadget->dev, "%s: cannot queue: %d\n",
+			__func__, value);
+		req->status = 0;
+	}
+	return value;
+}
+
+/* --------------------------------------------------------------------------
+ * configfs
+ */
+
+static inline struct f_uac2_opts *to_f_uac2_opts(struct config_item *item)
+{
+	return container_of(to_config_group(item), struct f_uac2_opts,
+			    func_inst.group);
+}
+
+static void f_uac2_attr_release(struct config_item *item)
+{
+	struct f_uac2_opts *opts = to_f_uac2_opts(item);
+
+	usb_put_function_instance(&opts->func_inst);
+}
+
+static struct configfs_item_operations f_uac2_item_ops = {
+	.release	= f_uac2_attr_release,
+};
+
+#define UAC2_ATTRIBUTE(name)						\
+static ssize_t f_uac2_opts_##name##_show(struct config_item *item,	\
+					 char *page)			\
+{									\
+	struct f_uac2_opts *opts = to_f_uac2_opts(item);		\
+	int result;							\
+									\
+	mutex_lock(&opts->lock);					\
+	result = sprintf(page, "%u\n", opts->name);			\
+	mutex_unlock(&opts->lock);					\
+									\
+	return result;							\
+}									\
+									\
+static ssize_t f_uac2_opts_##name##_store(struct config_item *item,	\
+					  const char *page, size_t len)	\
+{									\
+	struct f_uac2_opts *opts = to_f_uac2_opts(item);		\
+	int ret;							\
+	u32 num;							\
+									\
+	mutex_lock(&opts->lock);					\
+	if (opts->refcnt) {						\
+		ret = -EBUSY;						\
+		goto end;						\
+	}								\
+									\
+	ret = kstrtou32(page, 0, &num);					\
+	if (ret)							\
+		goto end;						\
+									\
+	opts->name = num;						\
+	ret = len;							\
+									\
+end:									\
+	mutex_unlock(&opts->lock);					\
+	return ret;							\
+}									\
+									\
+CONFIGFS_ATTR(f_uac2_opts_, name)
+
+UAC2_ATTRIBUTE(p_chmask);
+UAC2_ATTRIBUTE(p_srate);
+UAC2_ATTRIBUTE(p_ssize);
+UAC2_ATTRIBUTE(c_chmask);
+UAC2_ATTRIBUTE(c_srate);
+UAC2_ATTRIBUTE(c_ssize);
+
+static struct configfs_attribute *f_uac2_attrs[] = {
+	&f_uac2_opts_attr_p_chmask,
+	&f_uac2_opts_attr_p_srate,
+	&f_uac2_opts_attr_p_ssize,
+	&f_uac2_opts_attr_c_chmask,
+	&f_uac2_opts_attr_c_srate,
+	&f_uac2_opts_attr_c_ssize,
+	NULL,
+};
+
+static struct config_item_type f_uac2_func_type = {
+	.ct_item_ops	= &f_uac2_item_ops,
+	.ct_attrs	= f_uac2_attrs,
+	.ct_owner	= THIS_MODULE,
+};
+
+static void afunc_free_inst(struct usb_function_instance *f)
+{
+	struct f_uac2_opts *opts;
+
+	opts = container_of(f, struct f_uac2_opts, func_inst);
+	kfree(opts);
+}
+
+static struct usb_function_instance *afunc_alloc_inst(void)
+{
+	struct f_uac2_opts *opts;
+
+	opts = kzalloc(sizeof(*opts), GFP_KERNEL);
+	if (!opts)
+		return ERR_PTR(-ENOMEM);
+
+	mutex_init(&opts->lock);
+	opts->func_inst.free_func_inst = afunc_free_inst;
+
+	config_group_init_type_name(&opts->func_inst.group, "",
+				    &f_uac2_func_type);
+
+	opts->p_chmask = UAC2_DEF_PCHMASK;
+	opts->p_srate = UAC2_DEF_PSRATE;
+	opts->p_ssize = UAC2_DEF_PSSIZE;
+	opts->c_chmask = UAC2_DEF_CCHMASK;
+	opts->c_srate = UAC2_DEF_CSRATE;
+	opts->c_ssize = UAC2_DEF_CSSIZE;
+	return &opts->func_inst;
+}
+
+static void afunc_free(struct usb_function *f)
+{
+	struct audio_dev *agdev = func_to_agdev(f);
+	struct f_uac2_opts *opts;
+
+	opts = container_of(f->fi, struct f_uac2_opts, func_inst);
+
+	mutex_lock(&uac_sa_lock);
+	if (g_agdev == agdev)
+		g_agdev = NULL;
+	mutex_unlock(&uac_sa_lock);
+	kfree(agdev);
+
+	mutex_lock(&opts->lock);
+	--opts->refcnt;
+	mutex_unlock(&opts->lock);
+}
+
+static struct usb_function *afunc_alloc(struct usb_function_instance *fi)
+{
+	struct audio_dev *agdev;
+	struct f_uac2_opts *opts;
+
+	mutex_lock(&uac_sa_lock);
+	if (g_agdev) {
+		/* /dev/uac_sa and its class exist once. */
+		mutex_unlock(&uac_sa_lock);
+		return ERR_PTR(-EBUSY);
+	}
+
+	agdev = kzalloc(sizeof(*agdev), GFP_KERNEL);
+	if (!agdev) {
+		mutex_unlock(&uac_sa_lock);
+		return ERR_PTR(-ENOMEM);
+	}
+	spin_lock_init(&agdev->ring.lock);
+	agdev->rate = DEFAULT_RATE;
+	agdev->bits = 16;
+	g_agdev = agdev;
+	mutex_unlock(&uac_sa_lock);
+
+	opts = container_of(fi, struct f_uac2_opts, func_inst);
+	mutex_lock(&opts->lock);
+	++opts->refcnt;
+	mutex_unlock(&opts->lock);
+
+	agdev->func.name = "uac_sa_func";
+	agdev->func.bind = afunc_bind;
+	agdev->func.unbind = afunc_unbind;
+	agdev->func.set_alt = afunc_set_alt;
+	agdev->func.get_alt = afunc_get_alt;
+	agdev->func.disable = afunc_disable;
+	agdev->func.setup = afunc_setup;
+	agdev->func.free_func = afunc_free;
+
+	return &agdev->func;
+}
+
+DECLARE_USB_FUNCTION(uac_sa, afunc_alloc_inst, afunc_alloc);
+
+static int __init uac_samod_init(void)
+{
+	return usb_function_register(&uac_sausb_func);
+}
+module_init(uac_samod_init);
+
+static void __exit uac_samod_exit(void)
+{
+	usb_function_unregister(&uac_sausb_func);
+}
+module_exit(uac_samod_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("USB DAC function (UAC2 with feedback and /dev/uac_sa)");

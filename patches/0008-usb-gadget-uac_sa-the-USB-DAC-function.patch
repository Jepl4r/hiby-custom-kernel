+	.bBitResolution = _bits,					\
+}
+
+USB_OUT_IF_DESC(usb_out_pcm24_if_desc, ALT_PCM24);
+USB_OUT_HDR_DESC(usb_out_pcm24_hdr_desc, UAC_FORMAT_TYPE_I_PCM, 3);
+USB_OUT_FMT_DESC(usb_out_pcm24_fmt_desc, 3, 24);
+

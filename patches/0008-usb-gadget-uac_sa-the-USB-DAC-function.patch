From d0a19ec6a812a7cd680beb21c56ef6f314c5acaf Mon Sep 17 00:00:00 2001
From: Mattia D'Oronzo <doronzomattia26@icloud.com>
Date: Mon, 5 Oct 2026 16:37:56 +0200
Subject: [PATCH 08/13] usb: gadget: uac_sa, the USB DAC function

Asynchronous UAC2 speaker with explicit feedback, 32 to 384 kHz, 16/24/32
bit PCM and native DSD, whose stream user space reads from /dev/uac_sa.
Descriptors, feedback table, ioctls and sysfs attributes match the
vendor kernel byte for byte.
---
 drivers/usb/gadget/Kconfig             |   14 +
 drivers/usb/gadget/function/Makefile   |    2 +
 drivers/usb/gadget/function/f_uac_sa.c | 1389 ++++++++++++++++++++++++
 3 files changed, 1405 insertions(+)
 create mode 100644 drivers/usb/gadget/function/f_uac_sa.c

diff --git a/drivers/usb/gadget/Kconfig b/drivers/usb/gadget/Kconfig
index 6977b224..0f324063 100644
--- a/drivers/usb/gadget/Kconfig
+++ b/drivers/usb/gadget/Kconfig
@@ -187,6 +187,9 @@ config USB_F_UAC1
 config USB_F_UAC2
 	tristate
 
+config USB_F_UAC_SA
+	tristate
+
 config USB_F_UVC
 	tristate
 
@@ -430,6 +433,17 @@ config USB_CONFIGFS_F_UAC2
 	  received from the USB Host and choose to provide whatever it
 	  wants as audio data to the USB Host.
 
+config USB_CONFIGFS_F_UAC_SA
+	bool "USB DAC (uac_sa)"
+	depends on USB_CONFIGFS
+	select USB_LIBCOMPOSITE
+	select USB_F_UAC_SA
+	help
+	  An asynchronous USB Audio Class 2.0 speaker with explicit feedback
+	  whose stream user space reads from /dev/uac_sa: the player as a
+	  USB DAC for a computer or a phone. PCM up to 384 kHz and, when
+	  enabled, native DSD. The function is "uac_sa" in configfs.
+
 config USB_CONFIGFS_F_MIDI
 	bool "MIDI function"
 	depends on USB_CONFIGFS

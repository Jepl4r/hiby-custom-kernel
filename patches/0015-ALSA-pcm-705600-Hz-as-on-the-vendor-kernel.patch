From e806ed732a2e09b33446ce259e5cc25ed8204435 Mon Sep 17 00:00:00 2001
From: Mattia D'Oronzo <doronzomattia26@icloud.com>
Date: Wed, 7 Oct 2026 18:55:00 +0200
Subject: [PATCH] ALSA: pcm: 705600 Hz as on the vendor kernel

The vendor kernel knows seventeen rates: 705600 Hz is bit 15 and
768000 Hz bit 16. The SDK has no 705600 Hz and gives bit 15 to
768000 Hz. The HiBy modules (soc_aic.ko, the codecs) are built with
the vendor numbering, so on the SDK numbering a 705600 Hz stream, DSD256
over DoP, is refused, and their bit for 768000 Hz names no rate.

Number the rates as the vendor kernel does, and let the dummy DAI
take 705600 Hz too, as there.
---
 include/sound/pcm.h     | 6 ++++--
 sound/core/pcm_native.c | 5 +++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/include/sound/pcm.h b/include/sound/pcm.h
index bda4ed6..037a747 100644
--- a/include/sound/pcm.h
+++ b/include/sound/pcm.h
@@ -131,7 +131,8 @@ struct snd_pcm_ops {
 #define SNDRV_PCM_RATE_192000		(1<<12)		/* 192000Hz */
 #define SNDRV_PCM_RATE_352800		(1<<13)		/* 352800Hz */
 #define SNDRV_PCM_RATE_384000		(1<<14)		/* 384000Hz */
-#define SNDRV_PCM_RATE_768000		(1<<15)		/* 768000Hz */
+#define SNDRV_PCM_RATE_705600		(1<<15)		/* 705600Hz */
+#define SNDRV_PCM_RATE_768000		(1<<16)		/* 768000Hz */
 
 #define SNDRV_PCM_RATE_CONTINUOUS	(1<<30)		/* continuous range */
 #define SNDRV_PCM_RATE_KNOT		(1<<31)		/* supports more non-continuos rates */
@@ -145,7 +146,8 @@ struct snd_pcm_ops {
 #define SNDRV_PCM_RATE_8000_192000	(SNDRV_PCM_RATE_8000_96000|SNDRV_PCM_RATE_176400|\
 					 SNDRV_PCM_RATE_192000)
 #define SNDRV_PCM_RATE_8000_768000	(SNDRV_PCM_RATE_8000_192000|SNDRV_PCM_RATE_352800|\
-                     SNDRV_PCM_RATE_384000|SNDRV_PCM_RATE_768000)
+                     SNDRV_PCM_RATE_384000|SNDRV_PCM_RATE_705600|\
+                     SNDRV_PCM_RATE_768000)
 
 #define _SNDRV_PCM_FMTBIT(fmt)		(1ULL << (__force int)SNDRV_PCM_FORMAT_##fmt)
 #define SNDRV_PCM_FMTBIT_S8		_SNDRV_PCM_FMTBIT(S8)
diff --git a/sound/core/pcm_native.c b/sound/core/pcm_native.c
index a8a7866..01237b4 100644
--- a/sound/core/pcm_native.c
+++ b/sound/core/pcm_native.c
@@ -2016,12 +2016,13 @@ static int snd_pcm_hw_rule_sample_bits(struct snd_pcm_hw_params *params,
 	return snd_interval_refine(hw_param_interval(params, rule->var), &t);
 }
 
-#if SNDRV_PCM_RATE_5512 != 1 << 0 || SNDRV_PCM_RATE_768000 != 1 << 15
+#if SNDRV_PCM_RATE_5512 != 1 << 0 || SNDRV_PCM_RATE_768000 != 1 << 16
 #error "Change this table"
 #endif
 
 static unsigned int rates[] = { 5512, 8000, 11025, 16000, 22050, 32000, 44100,
-                                 48000, 64000, 88200, 96000, 176400, 192000, 352800, 384000, 768000};
+                                 48000, 64000, 88200, 96000, 176400, 192000, 352800, 384000,
+                                 705600, 768000};
 
 const struct snd_pcm_hw_constraint_list snd_pcm_known_rates = {
 	.count = ARRAY_SIZE(rates),
-- 

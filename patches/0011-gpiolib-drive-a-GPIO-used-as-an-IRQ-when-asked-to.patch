From 02c1127e277968da66568342d4c573b78a8a9b5a Mon Sep 17 00:00:00 2001
From: Mattia D'Oronzo <doronzomattia26@icloud.com>
Date: Mon, 5 Oct 2026 18:37:27 +0200
Subject: [PATCH 11/13] gpiolib: drive a GPIO used as an IRQ when asked to

The GT9xx touch controller of the R3 Pro II is reset by driving its
interrupt line while the line is requested as an IRQ. The vendor kernel
logs the request and carries it out; refusing it leaves the controller
asleep after the first suspend, and the touch screen stops answering.
---
 drivers/gpio/gpiolib.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/gpio/gpiolib.c b/drivers/gpio/gpiolib.c
index 06d345b0..ae9bb66e 100644
--- a/drivers/gpio/gpiolib.c
+++ b/drivers/gpio/gpiolib.c
@@ -1122,13 +1122,15 @@ static int _gpiod_direction_output_raw(struct gpio_desc *desc, int value)
 	struct gpio_chip	*chip;
 	int			status = -EINVAL;
 
-	/* GPIOs used for IRQs shall not be set as output */
-	if (test_bit(FLAG_USED_AS_IRQ, &desc->flags)) {
+	/*
+	 * A GPIO used for an IRQ is still driven, as on the vendor kernel:
+	 * touch controllers like the GT9xx select their address and wake up
+	 * by driving their interrupt line during a reset.
+	 */
+	if (test_bit(FLAG_USED_AS_IRQ, &desc->flags))
 		gpiod_err(desc,
 			  "%s: tried to set a GPIO tied to an IRQ as output\n",
 			  __func__);
-		return -EIO;
-	}
 
 	/* Open drain pin should not be driven to 1 */
 	if (value && test_bit(FLAG_OPEN_DRAIN,  &desc->flags))

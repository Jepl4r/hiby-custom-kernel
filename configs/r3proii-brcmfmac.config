# Mainline brcmfmac for the BCM43430, as modules: loaded by wifi_on.sh while
# Wi-Fi is on, in place of the vendor cywdhd.ko. The kernel image does not
# change. Board power, the out-of-band interrupt and the Bluetooth rfkill come
# from modules/bcm_wlbt_power.
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y

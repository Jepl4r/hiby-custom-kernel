# Memory: what the 56 MB of the R3 Pro II are spent on, beyond parity with the
# stock kernel.

# Compressed swap in RAM: /dev/zram0, LZ4, set up at boot by
# /etc/init.d/S12zram.sh. Cold anonymous pages are compressed instead of the
# page cache being thrown out.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y

# Not used on this device, resident all the same. Netfilter and debugfs stay
# although nothing uses them: NETFILTER_INGRESS adds a field to struct
# net_device (cywdhd), and DEBUG_FS adds fields to the ASoC codec, component,
# card and DAPM structures (codec_cs43198_dual).
# mac80211 (cywdhd is fullmac and needs cfg80211 only, which stays)
# CONFIG_MAC80211 is not set
# the kernel's own NTFS (ntfs-3g mounts it)
# CONFIG_NTFS_FS is not set
# the names of data symbols in kallsyms (function names stay, for oopses)
# CONFIG_KALLSYMS_ALL is not set
# the crypto self-test vectors, checked once when an algorithm registers
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# the GBK codepage: FAT is mounted with the default codepage 437, exFAT with utf8
# CONFIG_NLS_CODEPAGE_936 is not set
# algorithms only mac80211 asked for; Bluetooth keeps AES, CMAC, ECB and
# SHA256, UBIFS keeps LZO and DEFLATE
# CONFIG_CRYPTO_CCM is not set
# CONFIG_CRYPTO_GCM is not set
# CONFIG_CRYPTO_GHASH is not set
# CONFIG_CRYPTO_SEQIV is not set
# CONFIG_CRYPTO_CTR is not set
# CONFIG_CRYPTO_ARC4 is not set
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set
# CONFIG_CRYPTO_CRC32C is not set
# Bluetooth High Speed (AMP over 802.11)
# CONFIG_BT_HS is not set

# I/O scheduler: deadline. CFQ idles and anticipates seeks for rotating disks;
# on the microSD and the NAND a seek costs nothing.
# CONFIG_IOSCHED_CFQ is not set
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
CONFIG_DEFAULT_IOSCHED="deadline"
